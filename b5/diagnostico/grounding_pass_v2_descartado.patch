+def _grounding_enabled() -> bool:
+    return os.environ.get("RAG_GROUNDING_PASS", "").strip().lower() in ("1", "true", "on")
+
+
+_GROUNDING_NO_INFO = "Desculpe, não tenho essa informação nos meus documentos. 😕"
+_SENTENCE_BREAK = re.compile(r"(?<=[.!?])\s+(?=\S)")
+_LIST_MARKER = re.compile(r"^\s*(?:[-*•]\s*)?\d+[.)]?$")
+_HAS_LETTER = re.compile(r"[^\W\d_]")
+
+
+def _split_units(answer: str) -> list:
+    """Quebra a resposta em [(linha, texto)] por frase, preservando a linha de
+    origem. Um marcador de lista solto ("1.") volta a se juntar à frase seguinte,
+    e um fragmento sem letra (emoji) se junta à anterior."""
+    units = []
+    for li, line in enumerate(answer.split("\n")):
+        parts = [p for p in _SENTENCE_BREAK.split(line) if p.strip()]
+        merged = []
+        for p in parts:
+            if merged and (_LIST_MARKER.match(merged[-1]) or not _HAS_LETTER.search(p)):
+                merged[-1] = f"{merged[-1]} {p}"
+            else:
+                merged.append(p)
+        units.extend((li, p) for p in merged)
+    return units
+
+
+def _ground_answer(answer: str, context: str,
+                   help_portal_directive: str, pure_question: str) -> str:
+    """Revisão de fidelidade (RAG_GROUNDING_PASS=1): o LLM aponta, por número,
+    as frases sem base no contexto e o código as remove — nada é reescrito.
+    Desligada por padrão. Em erro ou saída ilegível, devolve a resposta original:
+    o passo nunca derruba o atendimento."""
+    units = _split_units(answer)
+    if not units:
+        return answer
+    numbered = "\n".join(f"[{i}] {text.strip()}" for i, (_, text) in enumerate(units, 1))
+    system_content = GROUNDING_PROMPT_SYSTEM.format(
+        context=context,
+        help_portal_directive=help_portal_directive or "(vazia)",
+    )
+    user_content = GROUNDING_PROMPT_USER.format(numbered=numbered)
+    try:
+        chain = llm_provider.build_chat_model(role="answer") | StrOutputParser()
+        t0 = time.time()
+        with get_openai_callback() as cb:
+            verdict = chain.invoke([
+                SystemMessage(content=system_content),
+                HumanMessage(content=user_content),
+            ]).strip()
+        save_token_history(
+            llm_provider.service_label(), os.environ.get("API_KEY", ""), "Answer_grounding",
+            cb.prompt_tokens, cb.completion_tokens, pure_question, datetime.now(),
+        )
+        llm_provider.observe("Answer_grounding", {
+            "service": llm_provider.service_label(),
+            "model": llm_provider.active_model("answer"),
+            "prompt_tokens": cb.prompt_tokens,
+            "completion_tokens": cb.completion_tokens,
+            "ttft_s": None,
+            "total_s": round(time.time() - t0, 3),
+            "truncated": False,
+        })
+    except Exception as e:
+        logger.warning("[RAG] revisão de fidelidade falhou — mantendo a resposta original | err=%s", e)
+        return answer
+
+    drop = {int(n) for n in re.findall(r"\d+", verdict) if 1 <= int(n) <= len(units)}
+    if not drop:
+        return answer
+
+    kept_by_line: dict = {}
+    for i, (li, text) in enumerate(units, 1):
+        if i not in drop:
+            kept_by_line.setdefault(li, []).append(text.strip())
+    if not kept_by_line:
+        logger.info("[RAG] revisão de fidelidade: nenhuma frase com base — resposta vira 'não tenho'")
+        return _GROUNDING_NO_INFO
+
+    content_lines = {li for li, _ in units}
+    out = []
+    for li, line in enumerate(answer.split("\n")):
+        if li in kept_by_line:
+            out.append(" ".join(kept_by_line[li]))
+        elif li not in content_lines and out and out[-1] != "":
+            out.append("")  # linha em branco original (separador de parágrafo)
+    revised = "\n".join(out).strip()
+    logger.info("[RAG] revisão de fidelidade cortou %d de %d frases", len(drop), len(units))
+    return revised or answer
+
+
 def get_qa_system(org_id: str, features) -> Any:
