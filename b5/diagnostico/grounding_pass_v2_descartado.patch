+# ---------------------------------------------------------------------------
+# GROUNDING — revisão de fidelidade da resposta RAG (RAG_GROUNDING_PASS=1)
+# O verificador de resposta só julga relevância; este passo corta o que o
+# contexto não sustenta (passo, promessa, consequência, canal inventados).
+# ---------------------------------------------------------------------------
+
+# Sem a pergunta de propósito: o passo só julga se cada frase tem base no
+# contexto, nunca se a resposta atende à pergunta (isso é do answer_verifier).
+# Com a pergunta, uma resposta ao "não sei minha SUSEP" era zerada por inteiro.
+# A saída é só a lista de números — o corte é feito no código, sem reescrita.
+GROUNDING_PROMPT_SYSTEM = """Você confere frases de um atendente virtual contra o CONTEXTO, que é a única fonte de verdade.
+
+CONTEXTO:
+{context}
+
+DIRETIVA DA EMPRESA (também vale como fonte):
+{help_portal_directive}
+
+Liste as frases que afirmam algo que o CONTEXTO e a DIRETIVA não dizem: passo, menu, campo, tela,
+caminho, link, e-mail, canal, prazo, valor, regra, consequência, promessa ("nossa equipe vai..."),
+garantia ou recomendação que não esteja escrita lá. Uma frase que parafraseia o CONTEXTO tem base.
+Nunca liste cumprimentos, "De nada" nem frases "Sobre [parte], não tenho essa informação nos meus documentos."
+
+Cada frase vem com um número entre colchetes. Responda só com esses números separados por
+vírgula (ex.: 2,5) ou NENHUMA."""
+
+GROUNDING_PROMPT_USER = """FRASES:
+{numbered}"""
+
+
