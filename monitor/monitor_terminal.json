      "foreground": "#CCCCCC",
      "useAcrylic": false,
      "opacity": 100,
      "backgroundImage": null,
      "experimental.retroTerminalEffect": false,
      "font": { "face": "Cascadia Mono", "size": 10 },
      "padding": "8",
      "scrollbarState": "hidden",
      "snapOnInput": true,
      "closeOnExit": "graceful",
      "icon": "📊"
    }
  ]
